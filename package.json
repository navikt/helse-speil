{
    "name": "helse-speil-frontend",
    "version": "2.0.0",
    "private": true,
    "author": "Team Bømlo",
    "description": "Innsyn i saksbehandling av sykepenger",
    "repository": {
        "type": "git",
        "url": "https://github.com/navikt/helse-speil.git"
    },
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": "24",
        "pnpm": ">=12"
    },
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "dev": "NEXT_PUBLIC_RUNTIME_ENV=mock PORT=1234 next dev --turbopack | pino-pretty --messageKey=message",
        "lokal-backend": "NEXT_PUBLIC_RUNTIME_ENV=lokal LOKALE_BACKENDS=spesialist,sporhund,vilkarsproving PORT=1234 next dev --turbopack | pino-pretty --messageKey=message",
        "lokal-spesialist": "NEXT_PUBLIC_RUNTIME_ENV=lokal LOKALE_BACKENDS=spesialist PORT=1234 next dev --turbopack | pino-pretty --messageKey=message",
        "lokal-sporhund": "NEXT_PUBLIC_RUNTIME_ENV=lokal LOKALE_BACKENDS=sporhund PORT=1234 next dev --turbopack | pino-pretty --messageKey=message",
        "lokal-vilkarsproving": "NEXT_PUBLIC_RUNTIME_ENV=lokal LOKALE_BACKENDS=vilkarsproving PORT=1234 next dev --turbopack | pino-pretty --messageKey=message",
        "import-testperson": "dev/importer-testdata.sh",
        "prebuild": "next telemetry disable",
        "preinstall": "npx only-allow pnpm",
        "build": "next build",
        "start": "next start",
        "lint": "eslint --ext=ts,tsx src",
        "lint:fix": "eslint --ext=ts,tsx src --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "pretsc": "next typegen",
        "tsc": "tsc",
        "generate-rest": "orval",
        "generate-rest:spesialist": "orval --project spesialist",
        "generate-rest:sporhund": "orval --project sporhund",
        "generate-rest:vilkarsproving": "orval --project vilkarsproving",
        "generate-sanity": "SPALTEN_DIR=${SPALTEN_DIR:-../spalten}; [ -d \"$SPALTEN_DIR\" ] || { echo \"Fant ikke spalten i '$SPALTEN_DIR'.\"; exit 1; }; pnpm --dir \"$SPALTEN_DIR\" exec sanity schema extract --enforce-required-fields --path \"$PWD/src/io/sanity/schema.json\" && \"$SPALTEN_DIR/node_modules/.bin/sanity\" typegen generate && prettier --write src/io/sanity/generated",
        "install-precommit-hooks": "husky",
        "lint-staged": "lint-staged"
    },
    "lint-staged": {
        "*.{js,css,md}": [
            "prettier --write --ignore-pattern 'src/io/rest/generated/**"
        ],
        "*.json": [
            "prettier --write --ignore-pattern 'src/spesialist-mock/data/personer/**'"
        ],
        "*.{ts,tsx}": [
            "eslint --fix"
        ]
    },
    "dependencies": {
        "@grafana/faro-web-sdk": "^2.12.1",
        "@grafana/faro-web-tracing": "^2.12.1",
        "@hookform/resolvers": "^6.0.0",
        "@navikt/aksel-icons": "^8.19.2",
        "@navikt/analytics-types": "0.0.9",
        "@navikt/ds-css": "^8.19.2",
        "@navikt/ds-react": "^8.19.2",
        "@navikt/ds-tailwind": "^8.19.2",
        "@navikt/next-logger": "^5.0.1",
        "@navikt/oasis": "^4.2.2",
        "@portabletext/react": "^8.0.1",
        "@prometheus-io/client": "^0.16.1",
        "@tanstack/react-query": "^5.104.5",
        "classnames": "^2.5.1",
        "dayjs": "^1.11.23",
        "groq": "^6.20.0",
        "jose": "^6.2.13",
        "jotai": "^3.0.1",
        "jotai-family": "^1.1.0",
        "json-edit-react": "^2.0.4",
        "motion": "^14.5.0",
        "next": "^16.4.2",
        "next-themes": "^0.4.6",
        "nextleton": "^0.6.1",
        "pino": "^10.4.0",
        "pino-socket": "^8.0.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.90.0",
        "remeda": "^2.52.0",
        "tailwind-merge": "^3.7.0",
        "use-debounce": "^10.1.1",
        "uuid": "^14.0.3",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@limegrass/eslint-plugin-import-alias": "^1.6.1",
        "@navikt/tsm-eslint-react": "^1.0.3",
        "@navikt/tsm-prettier": "^2.0.1",
        "@next/eslint-plugin-next": "^16.4.2",
        "@tailwindcss/postcss": "^4.3.3",
        "@tanstack/eslint-plugin-query": "^5.104.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "axe-core": "^4.14.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^10.13.0",
        "eslint-config-next": "^16.4.2",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.6.0",
        "next-router-mock": "^1.0.5",
        "orval": "^8.43.0",
        "pino-pretty": "^13.2.0",
        "postcss": "^8.5.31",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "sass": "^1.106.0",
        "tailwindcss": "^4.3.3",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    }
}
