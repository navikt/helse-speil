{
    "name": "helse-speil-frontend",
    "version": "2.0.0",
    "private": true,
    "author": "Team Bømlo",
    "description": "Innsyn i saksbehandling av sykepenger",
    "repository": {
        "type": "git",
        "url": "https://github.com/navikt/helse-speil.git"
    },
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": "24",
        "pnpm": ">=12"
    },
    "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
    "scripts": {
        "dev": "NEXT_PUBLIC_RUNTIME_ENV=mock PORT=1234 next dev --turbopack | pino-pretty --messageKey=message",
        "lokal-backend": "NEXT_PUBLIC_RUNTIME_ENV=lokal PORT=1234 next dev --turbopack | pino-pretty --messageKey=message",
        "lokal-spesialist": "NEXT_PUBLIC_RUNTIME_ENV=lokal-spesialist PORT=1234 next dev --turbopack | pino-pretty --messageKey=message",
        "lokal-sporhund": "NEXT_PUBLIC_RUNTIME_ENV=lokal-sporhund PORT=1234 next dev --turbopack | pino-pretty --messageKey=message",
        "import-testperson": "dev/importer-testdata.sh",
        "prebuild": "next telemetry disable",
        "preinstall": "npx only-allow pnpm",
        "build": "next build",
        "start": "next start",
        "lint": "eslint --ext=ts,tsx src",
        "lint:fix": "eslint --ext=ts,tsx src --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "pretsc": "next typegen",
        "tsc": "tsc",
        "generate-rest": "orval",
        "generate-rest:spesialist": "orval --project spesialist",
        "generate-rest:sporhund": "orval --project sporhund",
        "generate-rest:vilkarsproving": "orval --project vilkarsproving",
        "generate-graphql": "BEARER_TOKEN=$(curl http://localhost:8080/local-token) graphql-codegen --config graphql-codegen.yml",
        "install-precommit-hooks": "husky",
        "lint-staged": "lint-staged"
    },
    "lint-staged": {
        "*.{js,css,md}": [
            "prettier --write --ignore-pattern 'src/io/rest/generated/**"
        ],
        "*.json": [
            "prettier --write --ignore-pattern 'src/spesialist-mock/data/personer/**'"
        ],
        "*.{ts,tsx}": [
            "eslint --fix"
        ]
    },
    "dependencies": {
        "@apollo/client": "^3.14.1",
        "@grafana/faro-web-sdk": "^2.11.0",
        "@grafana/faro-web-tracing": "^2.11.0",
        "@hookform/resolvers": "^5.9.1",
        "@navikt/aksel-icons": "^8.16.2",
        "@navikt/ds-css": "^8.16.2",
        "@navikt/ds-react": "^8.16.2",
        "@navikt/ds-tailwind": "^8.16.2",
        "@navikt/next-logger": "^5.0.1",
        "@navikt/oasis": "^4.2.2",
        "@portabletext/react": "^8.0.1",
        "@prometheus-io/client": "^0.16.1",
        "@tanstack/react-query": "^5.103.1",
        "axios": "^1.20.0",
        "classnames": "^2.5.1",
        "dayjs": "^1.11.23",
        "graphql": "^16.14.2",
        "graphql-yoga": "^5.24.0",
        "jose": "^6.2.12",
        "jotai": "^3.0.0",
        "jotai-family": "^1.1.0",
        "motion": "^13.4.0",
        "next": "^16.3.5",
        "next-themes": "^0.4.6",
        "nextleton": "^0.6.1",
        "pino": "^10.3.1",
        "pino-socket": "^8.0.0",
        "qs": "^6.16.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-hook-form": "^7.88.0",
        "remeda": "^2.50.0",
        "tailwind-merge": "^3.7.0",
        "use-debounce": "^10.1.1",
        "uuid": "^14.0.2",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@graphiql/toolkit": "^0.12.1",
        "@graphql-codegen/cli": "^7.4.1",
        "@graphql-codegen/fragment-matcher": "^7.1.0",
        "@graphql-codegen/introspection": "^6.1.0",
        "@graphql-codegen/typed-document-node": "^7.1.0",
        "@graphql-codegen/typescript": "^6.1.0",
        "@graphql-codegen/typescript-operations": "^6.1.6",
        "@graphql-tools/schema": "^10.1.1",
        "@graphql-tools/utils": "^12.0.1",
        "@graphql-typed-document-node/core": "^3.2.0",
        "@limegrass/eslint-plugin-import-alias": "^1.6.1",
        "@navikt/tsm-eslint-react": "^1.0.3",
        "@navikt/tsm-prettier": "^2.0.1",
        "@next/eslint-plugin-next": "^16.3.5",
        "@tailwindcss/postcss": "^4.3.3",
        "@tanstack/eslint-plugin-query": "^5.103.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.5.1",
        "@types/qs": "^6.15.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "axe-core": "^4.13.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.5",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "jsdom": "^30.1.0",
        "lint-staged": "^17.5.1",
        "next-router-mock": "^1.0.5",
        "openapi3-ts": "^4.6.1",
        "orval": "^7.17.0",
        "pino-pretty": "^13.1.3",
        "postcss": "^8.5.28",
        "prettier": "^3.9.7",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "sass": "^1.104.1",
        "tailwindcss": "^4.3.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    }
}
