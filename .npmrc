registry=https://registry.npmjs.org
@navikt:registry=https://npm.pkg.github.com
# Auth-token ligger i bruker-nivå ~/.npmrc — pnpm ekspanderer ikke miljøvariabler i prosjekt-.npmrc (sikkerhetstiltak)

# Inkluder Linux binaries i lockfile selv om vi bruker macOS
supportedArchitectures.os=current,linux
supportedArchitectures.cpu=current,x64